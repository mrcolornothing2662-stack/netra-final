# ==============================================================================
# CyberDrishti AI / Netra — Environment Configuration Contract
# ==============================================================================
# Copy to .env and adjust for local environment or deployment.
# In production (ENVIRONMENT=production), boot fails fast if SECRET_KEY,
# DATABASE_URL, or INITIAL_ADMIN_PASSWORD are weak or missing.
# ==============================================================================

# Core environment: development | staging | production
ENVIRONMENT=development
DEBUG=true

# Security & Authentication (Required: SECRET_KEY >= 32 characters in production)
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_32_CHAR_MIN
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 16 recommended)
# Sync migrations and async FastAPI handlers both derive from this URL.
DATABASE_URL=postgresql://cyberdrishti:cyberdrishti_secret@localhost:5432/cyberdrishti
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Cache & Queues
REDIS_URL=redis://localhost:6379/0

# Autonomous Agent & LLM Inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=120
GEMINI_API_KEY=
ALLOW_CLOUD_AI=true
ARMORIQ_API_KEY=

# Local Model Artifacts & Storage Paths
ARTIFACTS_DIR=./artifacts
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100
CHROMA_PERSIST_DIR=./artifacts/chroma_db
REPORT_OUTPUT_DIR=./reports

# Analysis Tuning Parameters
FUZZY_MERGE_THRESHOLD=0.85
HIDDEN_LINK_TEMPORAL_TAU=3600.0
HIDDEN_LINK_FIN_TAU=7200.0
HIDDEN_LINK_MIN_PRECISION=0.90

# Immutable Audit Ledger Anchor
AUDIT_GENESIS_SEED=CYBERDRISHTI_GENESIS

# Initial Administrator Seed (Bootstrapped via cli.py bootstrap-admin)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_12_CHARS
INITIAL_ADMIN_EMAIL=admin@cyberdrishti.gov.in
INITIAL_ADMIN_FULL_NAME=Administrator

# CORS Origins (JSON list or comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
